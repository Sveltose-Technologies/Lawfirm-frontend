      "default": "./dist/react/index.js"
    },
    "./dist/menu": {
      "types": "./dist/menu/index.d.ts",
      "import": "./dist/menu/index.js",
      "require": "./dist/cjs/menu/index.js",
      "default": "./dist/menu/index.js"
    },
    "./dist/cjs/*": "./dist/cjs/*",
    "./dist/*": {
      "import": "./dist/*",
      "require": "./dist/cjs/*",
      "default": "./dist/*"
    },
    "./*.js": {
      "import": "./dist/*.js",
      "require": "./dist/cjs/*.js",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/cjs/*.js",
